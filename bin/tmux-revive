#!/usr/bin/env bash
# tmux-revive command line.
#   tmux-revive                      wake: start tmux, restore, attach
#   tmux-revive start                start tmux and restore, don't attach
#   tmux-revive save                 snapshot now
#   tmux-revive restore [SNAPSHOT]   restore latest (or a named snapshot)
#   tmux-revive status [SNAPSHOT]    what a restore would bring back
#   tmux-revive panel                live control panel for every pane and agent
#   tmux-revive list                 snapshots, newest first
#   tmux-revive log                  recent activity
#   tmux-revive doctor               check the moving parts
#   tmux-revive update               install the latest version (keeps snapshots)
#   tmux-revive uninstall [--purge]  remove (--purge also deletes snapshots)
if ((BASH_VERSINFO[0] < 4)); then
	for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do [[ -x $b ]] && exec "$b" "$0" "$@"; done
	echo "tmux-revive needs bash 4+ (macOS: brew install bash)" >&2
	exit 1
fi
set -uo pipefail
self=${BASH_SOURCE[0]}
while [[ -L $self ]]; do
	t=$(readlink "$self")
	[[ $t == /* ]] && self=$t || self=$(dirname "$self")/$t
done
ROOT="$(cd "$(dirname "$self")/.." && pwd)"
# shellcheck source=../scripts/common.sh
source "$ROOT/scripts/common.sh"

case ${1:-wake} in
wake)
	# Inside tmux there is nothing to wake; show what's saved instead.
	[[ -n ${TMUX:-} ]] && exec "$BASH" "$ROOT/scripts/restore.sh" --dry-run
	# A fresh `tmux` loads the config, which auto-restores and replaces the
	# empty session it starts with. A live server just needs attaching. Under
	# the user's own umask: a server started here hands it to every shell.
	umask "$REVIVE_UMASK"
	tmux has-session 2>/dev/null && exec tmux attach
	exec tmux
	;;
start)
	# Start the server after a reboot and wait for the restore, so that a
	# plain `tmux attach` finds every session (see scripts/shell.sh).
	server_alive && exit 0
	state=$(revive_dir)/last/state.json
	[[ -f $state && $(jq '.sessions | length' "$state") != 0 ]] || exit 0
	tm new-session -d || exit 1 # loads the config, which restores
	for _ in $(seq 150); do
		[[ $(opt @revive-done '') == 1 ]] && break
		sleep 0.1
	done
	;;
uninstall)
	inst=$ROOT/install.sh
	[[ ${2:-} == --purge ]] && exec sh "$inst" --purge
	exec sh "$inst" --uninstall
	;;
update)
	# Rerun the latest installer: it replaces the app in place and reapplies the
	# tmux, shell and agent setup. Snapshots are kept. REVIVE_SOURCE=dir updates
	# from a local checkout instead of downloading.
	shift
	if [[ -n ${REVIVE_SOURCE:-} ]]; then exec sh "$REVIVE_SOURCE/install.sh" "$@"; fi
	repo=${REVIVE_REPO:-odysseyalive/tmux-revive} ref=${REVIVE_REF:-main}
	# Pin the commit first and hand it on, so the installer fetched here and the app it
	# downloads are the same version even if main moves in between.
	api="https://api.github.com/repos/$repo/commits/$ref"
	if command -v curl >/dev/null; then sha=$(curl -fsSL -H 'Accept: application/vnd.github.sha' "$api" 2>/dev/null)
	else sha=$(wget -qO- --header='Accept: application/vnd.github.sha' "$api" 2>/dev/null); fi
	[[ $sha =~ ^[0-9a-f]{40}$ ]] && ref=$sha # else the installer looks it up itself
	url="https://raw.githubusercontent.com/$repo/$ref/install.sh"
	inst=$(mktemp) || exit 1
	trap 'rm -f "$inst"' EXIT
	if command -v curl >/dev/null; then curl -fsSL "$url" -o "$inst"; else wget -qO "$inst" "$url"; fi ||
		{ echo "tmux-revive: download failed: $url" >&2; exit 1; }
	REVIVE_REF=$ref sh "$inst" "$@"
	;;
save) "$BASH" "$ROOT/scripts/save.sh" manual ;;
restore) shift; "$BASH" "$ROOT/scripts/restore.sh" "$@" ;;
status) shift; "$BASH" "$ROOT/scripts/restore.sh" --dry-run "$@" ;;
panel) shift; exec "$BASH" "$ROOT/scripts/panel.sh" "$@" ;;
list)
	DIR=$(revive_dir)
	cur=$(cd -P "$DIR/last" 2>/dev/null && pwd)
	for d in $(find "$DIR/snapshots" -mindepth 1 -maxdepth 1 -type d | sort -r); do
		mark=" "
		[[ $d == "$cur" ]] && mark="*"
		jq -r --arg m "$mark" --arg id "${d##*/}" \
			'"\($m) \($id)  \(.saved_at)  \(.reason)  \([.sessions[].windows[].panes[]] | length) panes, \([.sessions[].windows[].panes[] | select(.kind | test("^(claude|codex|cursor|crush|gemini)$"))] | length) agents"' \
			"$d/state.json" 2>/dev/null
	done
	;;
log) tail -n "${2:-30}" "$(revive_dir)/revive.log" ;;
doctor)
	ok() { printf '  \033[32mok\033[0m   %s\n' "$*"; }
	bad() { printf '  \033[31mno\033[0m   %s\n' "$*"; }
	for c in tmux jq ps; do command -v "$c" >/dev/null && ok "$c" || bad "$c missing (required)"; done
	for c in systemd-inhibit gdbus; do command -v "$c" >/dev/null && ok "$c" || bad "$c missing: no final save on shutdown, interval saves only"; done
	if server_alive; then
		spid=$(tm display-message -p '#{pid}')
		pgrep -f "daemon.sh" >/dev/null && ok "daemon running (server $spid)" || bad "daemon not running: is revive.tmux loaded?"
		systemd-inhibit --list --no-pager 2>/dev/null | grep -q tmux-revive && ok "shutdown/sleep inhibitor held" || bad "no logind inhibitor held"
		[[ -n $(tm show-hooks -g client-detached 2>/dev/null | grep save.sh) ]] && ok "save-on-detach hook" || bad "save-on-detach hook missing"
	else
		bad "no tmux server running"
	fi
	command -v agent-say >/dev/null && ok "agent-say on PATH" || bad "agent-say not on PATH"
	codex_home=${CODEX_HOME:-$HOME/.codex}
	if [[ -d $codex_home ]]; then
		[[ -f $codex_home/rules/agent-say.rules ]] && ok "Codex may run agent-say outside its sandbox" ||
			bad "Codex can't reach tmux to use agent-say: run tmux-revive update"
	fi
	DIR=$(revive_dir)
	[[ -f $DIR/last/state.json ]] && ok "latest snapshot: $(jq -r .saved_at "$DIR/last/state.json")" || bad "no snapshot yet"
	;;
*) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
